<mxfile><diagram id="ctx" name="情境圖"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;海大二手書交易平台&lt;/b&gt;&lt;br&gt;&lt;br&gt;書籍列表與搜尋・刊登書籍&lt;br&gt;購物車與訂單・審核書籍・帳號" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="320" height="160" as="geometry"/></mxCell><mxCell id="c2" value="賣家" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="40" height="80" as="geometry"/></mxCell><mxCell id="c3" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="215" as="sourcePoint"/><mxPoint x="400" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="刊登書籍、接受或拒絕訂單" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="120" y="185" width="270" height="28" as="geometry"/></mxCell><mxCell id="c5" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="285" as="sourcePoint"/><mxPoint x="110" y="285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="收到的訂單、審核結果與退回原因" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="120" y="288" width="270" height="28" as="geometry"/></mxCell><mxCell id="c7" value="買家" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="200" width="40" height="80" as="geometry"/></mxCell><mxCell id="c8" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="215" as="sourcePoint"/><mxPoint x="720" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="搜尋書籍、送出訂單、確認收到、取消" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="730" y="185" width="270" height="28" as="geometry"/></mxCell><mxCell id="c10" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="285" as="sourcePoint"/><mxPoint x="1010" y="285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="書籍列表、訂單狀態（含被拒絕的原因）" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="730" y="288" width="270" height="28" as="geometry"/></mxCell><mxCell id="c12" value="管理員" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=15;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="470" width="40" height="80" as="geometry"/></mxCell><mxCell id="c13" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="330" as="sourcePoint"/><mxPoint x="520" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="待審核的書籍" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=right;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="112" height="28" as="geometry"/></mxCell><mxCell id="c15" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="470" as="sourcePoint"/><mxPoint x="600" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="核准或退回" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="608" y="380" width="112" height="28" as="geometry"/></mxCell><mxCell id="c17" style="html=1;dashed=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="190" as="sourcePoint"/><mxPoint x="1040" y="190" as="targetPoint"/><Array as="points"><mxPoint x="80" y="60"/><mxPoint x="1040" y="60"/></Array></mxGeometry></mxCell><mxCell id="c18" value="面交或寄送、付款（在平台外，由買賣雙方自行協調）" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="310" y="30" width="500" height="26" as="geometry"/></mxCell><mxCell id="c19" value="賣家和買家都是用學校 Email 註冊的海大學生，同一個帳號可以買書也可以賣書。" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>